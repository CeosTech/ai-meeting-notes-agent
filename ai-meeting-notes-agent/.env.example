# AWS region where Bedrock, Transcribe, Translate, Comprehend, and SES are enabled
AWS_REGION=us-east-1

# Verified SES sender email address
SENDER_EMAIL=verified-sender@example.com

# Step Functions state machine ARN (required for backend async pipeline)
SUMMARY_STATE_MACHINE_ARN=

# Optional flags
# Set to 1 to skip SES delivery during local tests
SKIP_EMAIL=0
# Override Transcribe job names (defaults to meeting-notes-agent)
TRANSCRIBE_JOB_PREFIX=meeting-notes-agent
# Maximum wait time (seconds) for a Transcribe job
TRANSCRIBE_TIMEOUT=900
# S3 bucket for Transcribe outputs (leave empty to use service-managed bucket)
TRANSCRIBE_OUTPUT_BUCKET=
# Absolute path or S3 URI to a custom prompt template (optional)
PROMPT_TEMPLATE_PATH=
# Target language for local_test.py (e.g., fr, en, es)
TARGET_LANGUAGE=
# Default email locale for localized templates (falls back to en)
DEFAULT_EMAIL_LOCALE=en
# Optional locale-specific overrides (example for French)
# EMAIL_SUBJECT_FR="Résumé automatique"
# EMAIL_GREETING_FR="Bonjour à tous,"
# EMAIL_INTRO_FR="Voici le compte-rendu automatique de notre réunion."
# EMAIL_SUMMARY_HEADING_FR="Résumé"
# EMAIL_CLOSING_FR="Cordialement,\nAgent AI Meeting Notes"
# EMAIL_META_DETECTED_FR="Langue détectée : {language}"
# EMAIL_META_TRANSLATED_FR="Résumé traduit en : {language}"
# Explicit email locale override for local tests (optional)
EMAIL_LOCALE=
